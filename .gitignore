# Dependencies
node_modules/
frontend/node_modules/
.venv/
venv/
env/

# Build Outputs
dist/
frontend/dist/
.vite/
frontend/.vite/
dist-ssr/

# Python Cache & Bytecode
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# Environment Variables & Secrets
.env
.env.local
*.env.local
!.env.example

# Vite local override files
*.local

# SQLite runtime sidecar files (app opens DBs in WAL mode)
# These are transient and must never be committed.
*.db-wal
*.db-shm
*.db-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal

# The generated SQLite data files live in data/. They are currently tracked
# so the app can run without regenerating. Uncomment to keep them out of git:
# data/*.db

# Python tooling & build artifacts
build/
*.egg-info/
.eggs/
.mypy_cache/
.ruff_cache/
.tox/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & OS Files
.vscode/
.idea/
.DS_Store
Thumbs.db
